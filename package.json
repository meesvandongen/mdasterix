{
  "name": "mdasterix",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/meesvandongen/mdasterix.git"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@types/mdast": "^4.0.1",
    "publint": "^0.3.25",
    "typescript": "^5.2.2",
    "vite-plus": "catalog:"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/meesvandongen/mdasterix/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "vp pack",
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "release": "pnpm run build && pnpm run test && changeset publish",
    "changeset": "changeset"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
